package plugins

import (
	"strings"

	"github.com/labstack/echo/v4"
	"github.com/yumenaka/comigo/config"
)

// AutoScrollPlugin 自动滚动插件（仅支持卷轴阅读）
templ AutoScrollPlugin(c echo.Context) {
	if config.GetCfg().EnablePlugin && config.GetCfg().IsPluginEnabled("auto_scroll") && strings.HasPrefix(config.StripBasePath(c.Request().URL.Path), "/scroll/") {
		if config.GetCfg().Debug {
			<script>
				console.log("Auto scroll plugin enabled");
			</script>
		}
		@AutoScrollControls()
	}
}

// AutoScrollControls 在在线卷轴和本地阅读器中提供统一的速度设置。
templ AutoScrollControls() {
	<div
		x-data="autoScroll"
		@visibilitychange.document="lastFrameTime = null"
		@pagehide.window="stopAutoScroll()"
		class="w-full comigo_plugin"
	>
		<button
			type="button"
			@click="autoScrollEnabled ? stopAutoScroll() : startAutoScroll()"
			:class="autoScrollEnabled ? 'bg-green-300 hover:bg-green-400' : 'bg-blue-200 hover:bg-indigo-300'"
			class="panel-control w-full mb-2 text-sm text-center inline-flex items-center justify-center px-2.5 py-2 border rounded text-black font-semibold focus:outline-none focus:ring transition delay-150 duration-300 ease-in-out"
		>
			<span x-text="autoScrollEnabled ? i18next.t('auto_flip_pause_scroll') : i18next.t('auto_flip_start_scroll')"></span>
		</button>
		<div class="relative w-full my-2 border-2 border-gray-500 dark:border-gray-200 rounded px-2 py-1.5">
			<label
				for="autoScrollSpeed"
				class="block w-full mb-0 font-medium"
				x-text="i18next.t('auto_scroll_speed') + ' (' + i18next.t('auto_scroll_speed_unit') + ')'"
			></label>
			<input
				id="autoScrollSpeed"
				type="number"
				min="1"
				step="any"
				inputmode="decimal"
				x-model.number="speed"
				@keydown.stop
				@keyup.stop
				class="panel-control w-full px-2 py-1 border rounded"
			/>
		</div>
	</div>
}
